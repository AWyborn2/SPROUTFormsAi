modules = ["nodejs-20", "web", "bash", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["javascript_log_in_with_replit:2.0.0"]

[nix]
channel = "stable-25_05"
packages = ["psmisc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Backend API"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "API_PORT=8000 pnpm dev:api"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev:web"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/mockup-sandbox"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install && npm run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 23636
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "23636"
BASE_PATH = "/__mockup/"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8787
externalPort = 3002

[[ports]]
localPort = 23636
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "API_PORT=8000 pnpm --filter @formai/api start & pnpm --filter @formai/web preview --host 0.0.0.0 --port 5000"]

# MIGRATE IN THE BUILD, NOT THE RUN, AND NOT BY A GENERATED DIFF.
#
# `pnpm db:migrate` applies the migrations in packages/db/drizzle in order,
# recording each in the ledger. That is the only mechanism that runs a DATA
# migration: a schema diff reproduces structure and silently skips every
# UPDATE. 0042_seed_profiles_category is the worked example — it backfills the
# `profiles` permission key into role matrices, was skipped by exactly such a
# sync, and every organisation with a stored matrix resolved profile access to
# DENIED. An empty screen, no error, and hours to find.
#
# In `build` rather than `run` because autoscale starts many instances from one
# build. Migrating in `run` races every replica against the others; migrating
# in `build` happens once, before anything serves traffic.
#
# It is deliberately NOT guarded against a missing DATABASE_URL. A deploy that
# cannot migrate must fail here, loudly, rather than start on a schema its code
# does not expect.
build = ["bash", "-c", "pnpm -r build && pnpm db:migrate"]

[userenv]

[userenv.shared]
NODE_ENV = "development"
STORAGE_PROVIDER = "replit"

[userenv.production]
WEB_ORIGIN = "https://sproutonlineforms.replit.app"

[userenv.development]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[objectStorage]
defaultBucketID = "replit-objstore-74ec84cf-31b8-4609-9dfe-ddde44a2d841"
